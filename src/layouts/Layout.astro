---
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import { SITE } from '../data/site';
import defaultSocialImage from '../assets/heroImage.avif';
import { buildBaseSchema, buildSchemaGraph, normalizePath, SCHEMA_IDS } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  pageType?: 'WebPage' | 'CollectionPage' | 'AboutPage' | 'ContactPage';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  pageSchema?: Record<string, unknown>;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  canonical,
  image,
  imageAlt = 'Lucía Millán Jiménez, psicóloga general sanitaria en Ciudad Real',
  imageWidth,
  imageHeight,
  type = 'website',
  pageType = 'WebPage',
  noindex = false,
  publishedTime,
  modifiedTime,
  section,
  pageSchema = {},
  schema,
} = Astro.props;
const siteURL = Astro.site || SITE.url;
const canonicalPath = normalizePath(canonical || Astro.url.pathname);
const canonicalURL = new URL(canonicalPath, `${siteURL}/`).href;
const generatedDefaultImage = await getImage({
  src: defaultSocialImage,
  width: 1200,
  height: 630,
  format: 'jpg',
  quality: 82,
});
const imageURL = new URL(image || generatedDefaultImage.src, `${siteURL}/`).href;
const socialImageWidth = imageWidth || (image ? undefined : 1200);
const socialImageHeight = imageHeight || (image ? undefined : 630);
const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const defaultPageSchema = {
  '@type': pageType,
  '@id': `${canonicalURL}#webpage`,
  url: canonicalURL,
  name: title,
  description,
  inLanguage: SITE.locale,
  isPartOf: { '@id': SCHEMA_IDS.website },
  publisher: { '@id': SCHEMA_IDS.practice },
  ...(publishedTime ? { datePublished: publishedTime } : {}),
  ...(modifiedTime ? { dateModified: modifiedTime } : {}),
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: imageURL,
    ...(socialImageWidth ? { width: socialImageWidth } : {}),
    ...(socialImageHeight ? { height: socialImageHeight } : {}),
  },
  ...pageSchema,
};
const extraSchema = Array.isArray(schema) ? schema : schema ? [schema] : [];
const schemaGraph = buildSchemaGraph([
  ...buildBaseSchema(imageURL),
  defaultPageSchema,
  ...extraSchema,
]);
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robotsContent} />
  <meta name="googlebot" content={robotsContent} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang="es-ES" href={canonicalURL} />
  <link rel="alternate" type="application/rss+xml" title="Blog de Lucía Millán Psicología" href={`${SITE.url}/rss.xml`} />
  <meta name="author" content={SITE.name} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
  {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content={SITE.businessName} />
  <meta property="og:locale" content="es_ES" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta property="og:image:secure_url" content={imageURL} />
  <meta property="og:image:alt" content={imageAlt} />
  {socialImageWidth && <meta property="og:image:width" content={String(socialImageWidth)} />}
  {socialImageHeight && <meta property="og:image:height" content={String(socialImageHeight)} />}
  {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  {type === 'article' && section && <meta property="article:section" content={section} />}
  {type === 'article' && <meta property="article:author" content={SITE.name} />}
  <meta name="twitter:image:alt" content={imageAlt} />
  <meta property="og:image" content={imageURL} />
  <meta name="twitter:image" content={imageURL} />
  <meta name="geo.region" content="ES-CM" />
  <meta name="geo.placename" content="Ciudad Real" />
  <meta name="theme-color" content="#faf8f3" />
  <Font cssVariable="--font-cormorant-garamond" />
  <Font cssVariable="--font-dm-sans" />
  <link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
</head>
<body>
  <div class="page-grain" aria-hidden="true"></div>
  <slot />

  <script>
    // Scroll Reveal — Enhanced observer with data-delay and data-threshold support
    const revealSelectors = '.reveal, .reveal-scale, .reveal-blur, .reveal-up, .reveal-scale-x, .stagger-children';
    const revealEls = document.querySelectorAll<HTMLElement>(revealSelectors);
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          const delay = parseFloat(target.dataset.delay || '0');
          if (delay > 0) {
            setTimeout(() => target.classList.add('visible'), delay);
          } else {
            target.classList.add('visible');
          }
          revealIO.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -60px 0px' });
    revealEls.forEach(el => revealIO.observe(el));

    // Parallax elements — elements with data-parallax
    const parallaxEls = document.querySelectorAll<HTMLElement>('[data-parallax]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (parallaxEls.length && !window.matchMedia('(pointer: coarse)').matches && !reduceMotion) {
      let ticking = false;
      function updateParallax() {
        parallaxEls.forEach(el => {
          const speed = parseFloat(el.dataset.parallax || '0.1');
          const rect = el.getBoundingClientRect();
          const elCenter = rect.top + rect.height / 2;
          const windowCenter = window.innerHeight / 2;
          const distance = (elCenter - windowCenter) * speed;
          el.style.transform = `translateY(${distance}px)`;
        });
        ticking = false;
      }
      window.addEventListener('scroll', () => {
        if (!ticking) { requestAnimationFrame(updateParallax); ticking = true; }
      }, { passive: true });
      updateParallax();
    }

    // Smooth anchors
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(a => {
      a.addEventListener('click', (e) => {
        const href = a.getAttribute('href');
        if (!href || href === '#') return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          const top = target.getBoundingClientRect().top + window.scrollY - 20;
          window.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
        }
      });
    });

    // ===== SPOTLIGHT CURSOR =====
    const allowPointerEffects = !window.matchMedia('(pointer: coarse), (prefers-reduced-motion: reduce)').matches;
    if (allowPointerEffects) document.querySelectorAll<HTMLElement>('.spotlight-section').forEach(sec => {
      const spot = document.createElement('div');
      spot.style.cssText = 'position:absolute;inset:0;pointer-events:none;z-index:1;overflow:hidden;';
      const glow = document.createElement('div');
      glow.style.cssText = 'position:absolute;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);transform:translate(-50%,-50%);pointer-events:none;opacity:0;transition:opacity 0.4s ease;';
      spot.appendChild(glow);
      sec.insertBefore(spot, sec.firstChild);
      sec.addEventListener('mousemove', (e) => {
        const pointer = e as MouseEvent;
        const rect = sec.getBoundingClientRect();
        glow.style.left = (pointer.clientX - rect.left) + 'px';
        glow.style.top = (pointer.clientY - rect.top) + 'px';
        glow.style.opacity = '1';
      });
      sec.addEventListener('mouseleave', () => { glow.style.opacity = '0'; });
    });
  </script>
</body>
</html>
