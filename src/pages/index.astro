---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import SobreMi from '../components/SobreMi.astro';
import QuePodemosTrabajar from '../components/QuePodemosTrabajar.astro';
import Proceso from '../components/Proceso.astro';
import BlogSection from '../components/BlogSection.astro';
import FAQ from '../components/FAQ.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import SectionDivider from '../components/SectionDivider.astro';
import { FAQS } from '../data/faq';

const homeSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': 'https://luciamillanpsicologia.es/#preguntas-frecuentes',
    mainEntity: FAQS.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
};
---

<Layout
  title="Psicóloga en Ciudad Real y online | Lucía Millán"
  description="Psicóloga general sanitaria en Ciudad Real y online. Terapia individual para ansiedad, trauma, duelo y autoestima. Solicita una primera sesión."
  pageSchema={{
    about: { '@id': 'https://luciamillanpsicologia.es/#lucia-millan-jimenez' },
    mainEntity: { '@id': 'https://luciamillanpsicologia.es/#preguntas-frecuentes' },
  }}
  schema={homeSchema}
>
  <Navigation />
  <main>
    <Hero />

    <Servicios />

    <!-- Cream to parchment -->
    <SectionDivider variant="wave" fromColor="#f2efe8" toColor="var(--parchment)" />

    <SobreMi />

    <!-- Parchment to cream -->
    <SectionDivider variant="hill" fromColor="#ebe5d8" toColor="var(--cream)" />

    <QuePodemosTrabajar />

    <Proceso />

    <!-- Warm cream to parchment -->
    <SectionDivider variant="wave" fromColor="#e8e1d4" toColor="#fffdfa" />

    <BlogSection />

    <!-- Parchment to white-warm -->
    <SectionDivider variant="valley" fromColor="#f2efe8" toColor="var(--white-warm)" />

    <FAQ />

    <!-- White-warm to accent-warm -->
    <SectionDivider variant="arch" fromColor="#f5f1ea" toColor="#e8e2d6" />

    <Contacto />
  </main>
  <Footer />
</Layout>
