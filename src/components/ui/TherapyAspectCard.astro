---
interface Props {
  number: string;
  label: string;
  title: string;
  description: string;
  color?: string;
  delay?: number;
}

const {
  number,
  label,
  title,
  description,
  color = '111, 125, 103',
  delay = 0,
} = Astro.props;
---

<article
  class="qt-card reveal-up"
  role="listitem"
  style={`--card-hue: ${color};${delay > 0 ? ` transition-delay: ${delay}ms;` : ''}`}
>
  <div class="qt-card__top">
    <span class="qt-card__num" aria-hidden="true">{number}</span>
    <span class="qt-card__label">{label}</span>
  </div>

  <h3 class="qt-card__title">{title}</h3>
  <div class="qt-card__rule" aria-hidden="true"></div>
  <p class="qt-card__text">{description}</p>

  <span class="qt-card__orb" aria-hidden="true"></span>
</article>

<style>
  .qt-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 100%;
    padding: clamp(1.15rem, 1.9vw, 1.45rem) clamp(1.15rem, 1.9vw, 1.5rem);
    border: 1px solid rgba(var(--card-hue), 0.13);
    border-radius: calc(var(--card-radius) - 5px);
    background:
      linear-gradient(155deg, rgba(255, 253, 248, 0.99) 0%, rgba(251, 248, 241, 0.9) 58%, rgba(248, 244, 236, 0.78) 100%),
      radial-gradient(circle at 88% 12%, rgba(var(--card-hue), 0.09), transparent 44%);
    box-shadow:
      0 0.65rem 1.5rem rgba(57, 54, 48, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.92);
    overflow: hidden;
    transition:
      border-color 0.45s ease,
      box-shadow 0.5s ease,
      transform 0.5s var(--ease-out-expo);
  }

  .qt-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, rgba(var(--card-hue), 0.58), rgba(var(--card-hue), 0.12));
    opacity: 0.8;
    transition: opacity 0.4s ease;
  }

  .qt-card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(125deg, rgba(var(--card-hue), 0.04) 0%, transparent 38%);
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  .qt-card:hover,
  .qt-card:focus-within {
    border-color: rgba(var(--card-hue), 0.24);
    box-shadow:
      0 1.1rem 2.4rem rgba(57, 54, 48, 0.07),
      0 0 0 1px rgba(var(--card-hue), 0.05) inset,
      inset 0 1px 0 rgba(255, 255, 255, 0.96);
    transform: translateY(-3px);
  }

  .qt-card:hover::before,
  .qt-card:focus-within::before,
  .qt-card:hover::after,
  .qt-card:focus-within::after {
    opacity: 1;
  }

  .qt-card__top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.7rem;
  }

  .qt-card__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    border: 1px solid rgba(var(--card-hue), 0.18);
    background: rgba(var(--card-hue), 0.09);
    font-family: var(--font-display);
    font-size: var(--type-body-sm);
    font-weight: 400;
    line-height: 1;
    color: rgba(var(--card-hue), 0.94);
    font-variant-numeric: tabular-nums;
  }

  .qt-card__label {
    display: inline-flex;
    align-items: center;
    min-height: 1.55rem;
    padding: 0.18rem 0.62rem;
    border-radius: 999px;
    border: 1px solid rgba(var(--card-hue), 0.15);
    background: rgba(var(--card-hue), 0.07);
    font-size: var(--type-caption);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(var(--card-hue), 0.92);
  }

  .qt-card__title {
    position: relative;
    z-index: 1;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.22rem, 1.75vw, 1.42rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .qt-card__rule {
    position: relative;
    z-index: 1;
    width: 2.4rem;
    height: 1px;
    margin: 0.55rem 0 0.65rem;
    background: linear-gradient(90deg, rgba(var(--card-hue), 0.45), rgba(var(--card-hue), 0.06));
    transition: width 0.5s var(--ease-out-expo);
  }

  .qt-card:hover .qt-card__rule,
  .qt-card:focus-within .qt-card__rule {
    width: 3.2rem;
  }

  .qt-card__text {
    position: relative;
    z-index: 1;
    margin: 0;
    flex: 1 1 auto;
    color: var(--color-text-secondary);
    font-size: var(--type-body-sm);
    line-height: 1.64;
    text-wrap: pretty;
  }

  .qt-card__orb {
    position: absolute;
    right: -1.1rem;
    bottom: -1.1rem;
    width: 5.8rem;
    aspect-ratio: 1;
    border: 1px solid rgba(var(--card-hue), 0.11);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.45), transparent 68%);
    pointer-events: none;
    transition: transform 0.55s var(--ease-out-expo), opacity 0.45s ease;
  }

  .qt-card:hover .qt-card__orb,
  .qt-card:focus-within .qt-card__orb {
    transform: scale(1.08);
    opacity: 0.95;
  }

  @media (max-width: 640px) {
    .qt-card {
      padding: 1rem 1.05rem;
    }

    .qt-card__top {
      margin-bottom: 0.6rem;
      gap: 0.5rem;
    }

    .qt-card__num {
      width: 1.75rem;
      height: 1.75rem;
      font-size: var(--type-meta);
    }

    .qt-card__label {
      font-size: 0.58rem;
      letter-spacing: 0.12em;
    }

    .qt-card__title {
      font-size: var(--type-subsection-title);
      line-height: 1.12;
    }

    .qt-card__rule {
      margin: 0.48rem 0 0.55rem;
    }

    .qt-card__text {
      font-size: var(--type-card-body);
      line-height: 1.58;
    }

    .qt-card__orb {
      width: 4.5rem;
      right: -0.85rem;
      bottom: -0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qt-card,
    .qt-card__rule,
    .qt-card__orb,
    .qt-card::after,
    .qt-card::before {
      transition: none;
    }

    .qt-card:hover,
    .qt-card:focus-within {
      transform: none;
    }
  }
</style>
