---
interface Props {
  class?: string;
  color?: string;
}

const { class: className = '', color = 'rgba(196,170,148,0.06)' } = Astro.props;
---

<div class:list={['ambient-light', className]} aria-hidden="true" style={`--light-color: ${color}`}></div>

<style>
  .ambient-light {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--light-color) 0%, transparent 70%);
    pointer-events: none;
    z-index: 1;
    transform: translate3d(var(--light-x, 0), var(--light-y, 0), 0) translate(-50%, -50%);
    transition: transform 0.4s ease-out;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-light {
      transition: none;
      will-change: auto;
    }
  }
</style>

<script>
  (function() {
    const lights = document.querySelectorAll('.ambient-light');
    const disablePointerEffects = window.matchMedia('(pointer: coarse), (prefers-reduced-motion: reduce)').matches;
    if (disablePointerEffects) return;

    lights.forEach(light => {
      const parent = light.closest('section, footer, .hero');
      if (!parent) return;
      const element = light as HTMLElement;
      const baseX = element.offsetLeft;
      const baseY = element.offsetTop;
      let frame = 0;
      parent.addEventListener('pointermove', (event) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          const pointer = event as PointerEvent;
          const rect = parent.getBoundingClientRect();
          element.style.setProperty('--light-x', `${pointer.clientX - rect.left - baseX}px`);
          element.style.setProperty('--light-y', `${pointer.clientY - rect.top - baseY}px`);
          frame = 0;
        });
      });
    });
  })();
</script>
